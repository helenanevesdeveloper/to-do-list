DATABASE_URL=replace-with-database-url

PASSWORD_HASH_ITERATIONS=600000
PASSWORD_HASH_SALT_BYTES=16
JWT_SECRET=change-me-to-a-long-random-secret
JWT_ISSUER=http://localhost:8000
JWT_AUDIENCE=todolist-web-dev
ACCESS_TOKEN_EXPIRES_SECONDS=900
ALLOWED_ORIGINS=http://localhost:3000

UPLOAD_MAX_FILE_SIZE_BYTES=10485760
UPLOAD_ALLOWED_EXTENSIONS=.jpg,.jpeg,.png,.pdf,.txt

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=replace-with-service-user-access-key-id
AWS_SECRET_ACCESS_KEY=replace-with-service-user-secret-access-key
AWS_S3_BUCKET_NAME=replace-with-your-s3-bucket-name

MAGALU_KEY_ID=replace-with-magalu-key-id
MAGALU_SECRET_KEY=replace-with-magalu-secret-key
MAGALU_REGION=br-se1
MAGALU_ENDPOINT_URL=https://br-se1.magaluobjects.com
MAGALU_BUCKET_NAME=replace-with-your-magalu-bucket-name

GCP_PROJECT_ID=your-gcp-project-id
GCS_BUCKET_NAME=your-gcs-bucket-name
# Local Docker path if you put the JSON under apps/backend/.secrets/
GOOGLE_APPLICATION_CREDENTIALS=/app/.secrets/gcp-service-account.json
