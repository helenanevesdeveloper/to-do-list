{
  "python.defaultInterpreterPath": "${workspaceFolder}/apps/backend/.venv/bin/python",
  "mypy-type-checker.importStrategy": "fromEnvironment",
  "mypy-type-checker.interpreter": [
    "${workspaceFolder}/apps/backend/.venv/bin/python"
  ],
  "mypy-type-checker.cwd": "${workspaceFolder}/apps/backend",
  "mypy-type-checker.args": ["--check-untyped-defs", "--show-error-codes"],
  "mypy-type-checker.reportingScope": "workspace",
  "pylint.path": ["${workspaceFolder}/apps/backend/.venv/bin/pylint"],
  "pylint.args": ["--rcfile=${workspaceFolder}/apps/backend/.pylintrc"],
  "[python]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.codeActionsOnSave": {
      "source.fixAll": "explicit",
      "source.organizeImports": "explicit"
    }
  },
  "python.testing.pytestArgs": ["tests"],
  "python.testing.unittestEnabled": false,
  "python.testing.pytestEnabled": true
}
