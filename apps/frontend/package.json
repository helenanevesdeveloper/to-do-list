{
  "name": "todo-list-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "perf:lighthouse:desktop": "mkdir -p ./test-results/lighthouse && lighthouse http://127.0.0.1:3000 --preset=desktop --output=html --output=json --output-path=./test-results/lighthouse/desktop-report --chrome-flags='--headless=new'",
    "perf:lighthouse:mobile": "mkdir -p ./test-results/lighthouse && lighthouse http://127.0.0.1:3000 --output=html --output=json --output-path=./test-results/lighthouse/mobile-report --chrome-flags='--headless=new'",
    "perf:local:desktop": "npm run build && start-server-and-test 'npm run preview' http://127.0.0.1:3000 'npm run perf:lighthouse:desktop'",
    "perf:local:mobile": "npm run build && start-server-and-test 'npm run preview' http://127.0.0.1:3000 'npm run perf:lighthouse:mobile'",
    "perf:assert": "npm run build && lhci autorun --config=./lighthouserc.json"
  },
  "dependencies": {
    "@chakra-ui/react": "^2.8.2",
    "@emotion/react": "^11.11.4",
    "@emotion/styled": "^11.11.5",
    "axios": "^1.7.7",
    "framer-motion": "^10.18.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.3",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.58.2",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^9.39.3",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "jsdom": "^24.1.3",
    "lighthouse": "^12.8.0",
    "start-server-and-test": "^2.1.2",
    "typescript": "^5.9.3",
    "vite": "^5.4.3",
    "vitest": "^4.0.18"
  }
}
