{
  "python.defaultInterpreterPath": "${workspaceFolder}/apps/backend/.venv/bin/python",
  "python.analysis.extraPaths": [
    "${workspaceFolder}/apps/backend"
  ],
  "pylint.importStrategy": "fromEnvironment",
  "pylint.path": [
    "${interpreter}",
    "-m",
    "pylint"
  ],
  "pylint.cwd": "${workspaceFolder}/apps/backend",
  "pylint.args": [
    "--rcfile=${workspaceFolder}/apps/backend/.pylintrc"
  ],
  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "python.testing.cwd": "${workspaceFolder}/apps/backend",
  "python.testing.pytestArgs": [
    "tests"
  ]
}
